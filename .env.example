# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use via OpenRouter
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Google OAuth client (choose ONE of the two below) ---

# Local development: path to the downloaded oauth_client.json file
GOOGLE_OAUTH_CLIENT_FILE=oauth_client.json

# Deployed environments (e.g. Render): paste the full oauth_client.json content
# as a single-line JSON string here instead of using a local file.
# GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...","client_secret":"...","...":"..."}}

# Must exactly match a redirect URI registered on the OAuth client in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/auth/callback

# The frontend origin, used for CORS and for redirecting back after login
FRONTEND_URL=http://localhost:5500

# Optional: comma-separated list of extra allowed CORS origins (e.g. a local
# dev frontend while testing against a deployed backend). FRONTEND_URL is
# always included automatically.
# EXTRA_CORS_ORIGINS=http://localhost:5500

# Any random string, used to sign the session cookie in this prototype
SESSION_SECRET=dev-only-secret-change-me
